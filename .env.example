# Optional — leave UNSET (or fully empty) to default to https://www.cyberoco.tech. Must be a full URL with https:// if set.
NEXT_PUBLIC_SITE_URL=https://www.cyberoco.tech
RESEND_API_KEY=
CONTACT_TO=info@cyberoco.tech
CONTACT_FROM=CYBEROCO Website <onboarding@resend.dev>

# ARIA chat assistant (POST /api/chat).
# NVIDIA Nemotron (primary) — free key from https://build.nvidia.com; starts
# with nvapi- and includes 1000 free credits. When set, Nemotron is the
# primary chat model.
NVIDIA_API_KEY=
# Gemini fallback — free key at https://aistudio.google.com
# (free tier ~1500 requests/day).
GEMINI_API_KEY=
# Optional; default depends on the active provider:
# nvidia/nemotron-3-nano-30b-a3b (NVIDIA) or gemini-2.5-flash-lite (Gemini).
# Selects a model WITHIN the active provider — it does not switch providers.
CHAT_MODEL=
# Optional; force "nvidia" or "gemini". Default: nvidia when NVIDIA_API_KEY
# is set, else gemini.
CHAT_PROVIDER=
# Set to 1 to kill chat instantly, no redeploy.
CHAT_DISABLED=